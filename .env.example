# Copy this file to .env. Never commit .env or production credentials.
# Generate each secret independently, for example: openssl rand -hex 32

# Application binding. Keep 127.0.0.1 when a reverse proxy runs on the host.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Public canonical URL, without a trailing slash. Use HTTPS in production.
# This NEXT_PUBLIC value is embedded during docker build and is not a secret.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# PostgreSQL. POSTGRES_PASSWORD must be URL-safe; `openssl rand -hex 32` is safe.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tensoract
POSTGRES_USER=payload
POSTGRES_PASSWORD=

# Used only when running Next.js directly on the host. Docker Compose builds its
# internal DATABASE_URL from the POSTGRES_* values and the `postgres` hostname.
DATABASE_URL=

# Required secrets. Use a different random value for every variable.
PAYLOAD_SECRET=
CRON_SECRET=
PREVIEW_SECRET=
